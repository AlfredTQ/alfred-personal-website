# Public URL of the deployed site (used for sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). Without a key the form falls back to opening the visitor's email app.
RESEND_API_KEY=
# Optional: verified sender and destination. Defaults: onboarding@resend.dev and the address in lib/content.ts.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
